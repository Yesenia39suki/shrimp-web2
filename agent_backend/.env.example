AGENT_BACKEND_APP_NAME=虾群养殖智能体服务
AGENT_BACKEND_APP_VERSION=0.1.0
AGENT_BACKEND_APP_ENV=development
AGENT_BACKEND_API_PREFIX=/api/v1
AGENT_BACKEND_SUPABASE_TIMEOUT_SECONDS=10

# 将下面两项替换为当前 Supabase 项目的实际值。
# 业务读取只使用 publishable key + 用户 JWT。
# AGENT_BACKEND_SUPABASE_URL=https://your-project.supabase.co
# AGENT_BACKEND_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# 仅供 advice_audit_writer 向 ai_request_logs 追加可信审计记录。
# 不得放入 Vue、请求参数、日志或 Git；优先使用 Supabase 新版 sb_secret_ key。
# AGENT_BACKEND_SUPABASE_SECRET_KEY=sb_secret_xxx

# DeepSeek API Key 只保存在后端，不要写入 Vue 或提交到 Git。
# AGENT_BACKEND_DEEPSEEK_API_KEY=sk-xxx
AGENT_BACKEND_DEEPSEEK_BASE_URL=https://api.deepseek.com
AGENT_BACKEND_DEEPSEEK_MODEL=deepseek-v4-pro
AGENT_BACKEND_DEEPSEEK_TIMEOUT_SECONDS=60
AGENT_BACKEND_DEEPSEEK_MAX_TOKENS=1200
AGENT_BACKEND_DEEPSEEK_MAX_RETRIES=1

# 业务数据新鲜度：只有“超过”阈值才判定过期或失联。
AGENT_BACKEND_WATER_STALE_AFTER_HOURS=24
AGENT_BACKEND_DEVICE_HEARTBEAT_STALE_AFTER_MINUTES=30
